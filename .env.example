# SkillPilot Environment Configuration

# Server
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="SkillPilot API"

# Security
SECRET_KEY=skillpilot-production-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite default, easy PostgreSQL migration)
DATABASE_URL=sqlite:///./skillpilot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/skillpilot

# Optional LLM API Keys (Deterministic local agent reasoning active if omitted)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vector Database (RAG)
CHROMA_PERSIST_DIR=./chroma_db
