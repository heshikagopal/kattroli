# KATTR0LI (கற்றொளி) Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="KATTR0LI (கற்றொளி) API"

# Security (JWT Session Token Generation)
SECRET_KEY=kattr0li-production-secret-key-2026-secure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite pre-seeded with baseline roles, catalog & accounts)
DATABASE_URL=sqlite:///./skillpilot.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://user:password@host:5432/kattr0li

# Optional LLM API Keys (High-quality deterministic fallback active if omitted)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vector Database (RAG)
CHROMA_PERSIST_DIR=./chroma_db

# Frontend Environment Variable (Set on Vercel / Render Static Site)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
